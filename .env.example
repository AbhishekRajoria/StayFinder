## Server
PORT=5000
NODE_ENV=development

## Database
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/stayfinder

## JWT
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

## Cookies
COOKIE_SECRET=replace-with-long-random-string
COOKIE_EXPIRES_IN=7

## CORS — frontend origin (no trailing slash)
CLIENT_URL=https://stayfinder-eta.vercel.app

## Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

## Stripe (payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_CURRENCY=usd
